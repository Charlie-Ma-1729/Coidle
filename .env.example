PORT=3000
# 監聽位址。正式環境預設 127.0.0.1（只給 nginx 連）；開發預設 0.0.0.0
HOST=
# 打包後的前端資料夾（預設 client/dist）
STATIC_DIR=
# 備份腳本用（deploy/backup.mjs）：備份資料夾與保留份數
BACKUP_DIR=backups
BACKUP_KEEP=14
# SQLite 資料庫檔案位置（預設 data/coidle.db）
DB_PATH=data/coidle.db
# 正式環境請設為 production（會啟用 secure cookie 與 WebSocket Origin 檢查）
NODE_ENV=development
# 設定後，註冊時必須輸入此密語，避免陌生人註冊（建議設）
SIGNUP_SECRET=
# 設定後才開放 /api/admin/... 旗標管理（用來開放區域／功能）；請用長隨機字串
ADMIN_TOKEN=
# 單一商場成員上限
MAX_MEMBERS=12
# Web Push（遇事暫停時跳通知）。沒設就只用應用內橫幅。
# 產生金鑰：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# AI 內容生成（快訊、評價、隨機事件）。金鑰只放在伺服器端 .env，不要提交；沒有金鑰就完全不啟用
OPENROUTER_API_KEY=
# 預設 anthropic/claude-haiku-5.5（實測繁體中文文筆、結構化輸出最穩，每次約 $0.0005）
OPENROUTER_MODEL=
# 每 30 天的預算上限（美元）。實際用到 85% 就停；單日最多 8%；每日最多 AI_DAILY_CALL_CAP 次呼叫
AI_BUDGET_USD=1
AI_DAILY_CALL_CAP=12
# 預算視窗起點（ISO 時間）。部署到新機器時填上原本的起點，才不會重新計算
AI_BUDGET_START=
# 這個視窗內已在別處（例如開發機）花掉的金額
AI_SPENT_ELSEWHERE_USD=0
# AI 產生的新事件預設要人工核准（npm run ai -- approve <id>）；設 true 會自動上線
AI_AUTO_APPROVE_EVENTS=false
# 只給模型比較測試用（server/src/ai/modeltest.ts）；正式服務不會讀它
OPENROUTER_TEST_KEY=
