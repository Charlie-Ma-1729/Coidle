{
  "name": "coidle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --tsconfig tsconfig.json server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts client",
    "build:client": "vite build --config client/vite.config.ts client",
    "start": "tsx --tsconfig tsconfig.json server/src/index.ts",
    "test": "vitest run",
    "ai": "tsx --tsconfig tsconfig.json server/src/ai/cli.ts",
    "admin": "tsx --tsconfig tsconfig.json server/src/admin/cli.ts",
    "sim": "tsx --tsconfig tsconfig.json server/src/bots/run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/websocket": "^11.3.7",
    "@preact/signals": "^2.11.4",
    "fastify": "^5.12.8",
    "preact": "^11.2.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
